# ==========================================================
# Imagination Environment Variables
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ==========================================================

# 1. MongoDB Atlas Connection String (Cloud Database)
# Free M0 cluster from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/imagination?retryWrites=true&w=majority

# 2. JWT Authentication Secret Key
# Secret key used to encrypt and verify student session tokens
JWT_SECRET=imagination-jee-maths-production-super-secret-key-2026

# 3. Initial Teacher / Admin Credentials
# (Automatically created in MongoDB if not already present)
ADMIN_EMAIL=admin@imagination.com
ADMIN_PASSWORD=Admin@123

# 4. Local Port (Used only during local node server.js execution)
PORT=3000
