# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/imagination?retryWrites=true&w=majority

# JWT Authentication Secret (Generate any random 64-character secret)
JWT_SECRET=imagination-super-secure-jwt-key-2026-production

# Primary Admin / Teacher Credentials
ADMIN_EMAIL=teacher1@imagination.com
ADMIN_PASSWORD=Teacher1StrongPassword123!

# Secondary Admin / Teacher Credentials (Optional)
ADMIN_EMAIL_2=teacher2@imagination.com
ADMIN_PASSWORD_2=Teacher2StrongPassword123!

# Node Environment
NODE_ENV=production
PORT=3000
